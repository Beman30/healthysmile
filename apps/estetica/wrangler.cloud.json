{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "healthy-smile-estetica",
  "account_id": "2a21262b1fce0d70b2659ccf4a80b72e",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthy-smile-estetica",
      "database_id": "1c5134f3-41e9-47a3-a77b-b02d93c8111b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "healthy-smile-estetica-foto",
      "jurisdiction": "eu"
    }
  ],
  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "nicolapalmia@gmail.com"
  }
}
