<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --charcoal: #1a1a1e;
  --charcoal-mid: #252529;
  --charcoal-light: #2e2e34;
  --magenta: #d4447c;
  --magenta-light: #e8659a;
  --magenta-pale: rgba(212,68,124,0.12);
  --cream: #f5f0ea;
  --text-dim: rgba(245,240,234,0.55);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { background: var(--charcoal); color: var(--cream); font-family: 'DM Sans', sans-serif; font-weight: 300; line-height: 1.65; overflow-x: hidden; }

/* NAV */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 1.2rem 4vw; background: rgba(26,26,30,0.9); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(212,68,124,0.15); }
.nav-logo { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; font-size: 1.45rem; color: var(--magenta); }
.nav-cta { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; background: var(--magenta); padding: 0.55rem 1.4rem; border-radius: 2px; text-decoration: none; transition: background 0.2s; }
.nav-cta:hover { background: var(--magenta-light); }

/* HERO */
.hero { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 8rem 6vw 5rem; position: relative; overflow: hidden; }
.hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 50% at 50% 60%, rgba(212,68,124,0.10) 0%, transparent 70%), radial-gradient(ellipse 40% 30% at 20% 20%, rgba(212,68,124,0.06) 0%, transparent 60%); pointer-events: none; }
.hero-eyebrow { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--magenta); margin-bottom: 1.8rem; opacity: 0; animation: fadeUp 0.8s 0.2s forwards; }
.hero-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(2.8rem, 7vw, 6.5rem); line-height: 1.08; color: var(--cream); max-width: 820px; opacity: 0; animation: fadeUp 0.9s 0.35s forwards; }
.hero-title em { font-style: italic; color: var(--magenta); }
.hero-sub { font-size: clamp(1rem, 1.8vw, 1.15rem); font-weight: 300; color: var(--text-dim); margin-top: 2rem; max-width: 520px; opacity: 0; animation: fadeUp 0.9s 0.55s forwards; }
.hero-divider { width: 1px; height: 60px; background: linear-gradient(to bottom, var(--magenta), transparent); margin: 3rem auto 0; opacity: 0; animation: fadeIn 1s 1s forwards; }

/* PILLARS */
.pillars { background: var(--charcoal-mid); padding: 7rem 6vw; border-top: 1px solid rgba(212,68,124,0.12); border-bottom: 1px solid rgba(212,68,124,0.12); }
.pillars-inner { max-width: 1100px; margin: 0 auto; }
.pillars-header { text-align: center; margin-bottom: 5rem; }
.section-label { font-size: 0.68rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--magenta); margin-bottom: 0.9rem; }
.section-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.12; color: var(--cream); margin-bottom: 1.6rem; }
.section-title em { font-style: italic; color: var(--magenta); }
.pillars-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 2px; }
.pillar { background: var(--charcoal-light); padding: 3rem 2.2rem; transition: background 0.25s; }
.pillar:hover { background: #35353d; }
.pillar:hover .pillar-num { color: var(--magenta); }
.pillar-num { font-family: 'Cormorant Garamond', serif; font-size: 3.5rem; font-weight: 300; color: rgba(212,68,124,0.22); line-height: 1; margin-bottom: 1.5rem; transition: color 0.25s; }
.pillar-title { font-size: 1rem; font-weight: 500; color: var(--cream); margin-bottom: 0.7rem; }
.pillar-desc { font-size: 0.88rem; color: var(--text-dim); line-height: 1.7; }
.pillar-tag { display: inline-block; margin-top: 1.4rem; font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--magenta); border: 1px solid rgba(212,68,124,0.3); padding: 0.3rem 0.7rem; border-radius: 1px; }

/* MANIFESTO */
.manifesto { padding: 7rem 6vw; max-width: 1100px; margin: 0 auto; border-top: 1px solid rgba(245,240,234,0.08); }
.manifesto-body { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.manifesto-text { font-size: 1.05rem; color: var(--text-dim); line-height: 1.8; margin-bottom: 1.2rem; }
.manifesto-text strong { color: var(--cream); font-weight: 400; }
.manifesto-quote { background: var(--charcoal-mid); border: 1px solid rgba(212,68,124,0.2); border-left: 3px solid var(--magenta); padding: 2.5rem; }
.manifesto-quote p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.7rem; font-weight: 300; line-height: 1.4; color: var(--cream); }
.manifesto-quote span { display: block; margin-top: 1.2rem; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--magenta); }

/* MYSTERY */
.mystery { background: linear-gradient(135deg, var(--magenta) 0%, #b03568 100%); padding: 6rem 6vw; text-align: center; }
.mystery-inner { max-width: 720px; margin: 0 auto; }
.mystery h2 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(2rem, 4.5vw, 3.8rem); color: #fff; line-height: 1.15; margin-bottom: 1.2rem; }
.mystery p { color: rgba(255,255,255,0.75); font-size: 1rem; max-width: 480px; margin: 0 auto 2.5rem; }
.mystery-cta { display: inline-block; background: #fff; color: var(--magenta); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 1rem 2.6rem; border-radius: 2px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
.mystery-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.25); }

/* PROMISE */
.promise { padding: 7rem 6vw; max-width: 1100px; margin: 0 auto; }
.promise-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: center; }
.promise-list { list-style: none; display: flex; flex-direction: column; gap: 1.6rem; }
.promise-list li { display: flex; gap: 1.2rem; align-items: flex-start; }
.promise-icon { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--magenta-pale); border: 1px solid rgba(212,68,124,0.3); display: flex; align-items: center; justify-content: center; }
.promise-icon svg { width: 16px; height: 16px; stroke: var(--magenta); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.promise-text strong { display: block; font-weight: 500; color: var(--cream); font-size: 0.97rem; margin-bottom: 0.2rem; }
.promise-text p { font-size: 0.86rem; color: var(--text-dim); line-height: 1.65; }
.promise-aside { background: var(--charcoal-mid); border: 1px solid rgba(245,240,234,0.07); padding: 3rem; text-align: center; }
.promise-aside .big { font-family: 'Cormorant Garamond', serif; font-size: 4.5rem; font-weight: 300; color: var(--magenta); line-height: 1; margin-bottom: 0.5rem; }
.promise-aside p { font-size: 0.9rem; color: var(--text-dim); line-height: 1.6; max-width: 220px; margin: 0 auto; }

/* HOOK / CTA */
.hook { border-top: 1px solid rgba(245,240,234,0.08); padding: 7rem 6vw; max-width: 1100px; margin: 0 auto; text-align: center; }
.hook .section-title { max-width: 640px; margin: 0 auto 1.5rem; }
.hook-sub { color: var(--text-dim); font-size: 1rem; max-width: 520px; margin: 0 auto 3.5rem; }
.cta-buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
.hook-btn { display: inline-flex; align-items: center; gap: 0.6rem; background: transparent; border: 1px solid var(--magenta); color: var(--magenta); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; padding: 1rem 2.2rem; border-radius: 2px; text-decoration: none; transition: background 0.2s, color 0.2s; }
.hook-btn:hover { background: var(--magenta); color: #fff; }
.hook-btn.filled { background: var(--magenta); color: #fff; }
.hook-btn.filled:hover { background: var(--magenta-light); }
.hook-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
.tel-display { margin-top: 2rem; font-size: 1.4rem; font-family: 'Cormorant Garamond', serif; font-weight: 300; color: var(--cream); letter-spacing: 0.05em; }
.tel-display a { color: var(--magenta); text-decoration: none; }
.tel-display a:hover { text-decoration: underline; }

/* FOOTER */
footer { background: #111114; padding: 3rem 6vw; border-top: 1px solid rgba(245,240,234,0.06); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
.footer-logo { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.3rem; color: var(--magenta); }
footer p { font-size: 0.78rem; color: var(--text-dim); }

/* ANIMATIONS */
@keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
.reveal.visible { opacity: 1; transform: none; }

@media (max-width: 720px) {
  .manifesto-body { grid-template-columns: 1fr; gap: 2.5rem; }
  .promise-grid { grid-template-columns: 1fr; }
  .promise-aside { order: -1; }
  footer { flex-direction: column; text-align: center; }
  .cta-buttons { flex-direction: column; align-items: center; }
}
</style>
</head>
<body>

<nav>
  <div class="nav-logo">Healthy Smile by N</div>
  <a href="#contatto" class="nav-cta">Scopri il Piano</a>
</nav>

<!-- HERO -->
<div class="hero">
  <p class="hero-eyebrow">Healthy Smile by N &middot; Struttura Sanitaria &middot; Torino</p>
  <h1 class="hero-title">
    Ti curiamo <em>meglio</em><br>per curarti meno.
  </h1>
  <p class="hero-sub">
    Non è una promessa generica. È un sistema progettato per te — e funziona in modo diverso da qualsiasi realtà tu abbia conosciuto finora.
  </p>
  <div class="hero-divider"></div>
</div>

<!-- PILLARS -->
<div class="pillars">
  <div class="pillars-inner">
    <div class="pillars-header reveal">
      <p class="section-label">Cosa succede davvero</p>
      <h2 class="section-title">Non una visita.<br>Un <em>sistema</em>.</h2>
    </div>
    <div class="pillars-grid">

      <div class="pillar reveal">
        <div class="pillar-num">01</div>
        <div class="pillar-title">La cartella non è nostra. È tua.</div>
        <p class="pillar-desc">Ogni informazione sulla tua salute viene raccolta in una cartella clinica digitale personalizzata. È tua, non nostra — accessibile, aggiornata, sempre consultabile quando vuoi.</p>
        <span class="pillar-tag">Digitale &amp; permanente</span>
      </div>

      <div class="pillar reveal">
        <div class="pillar-num">02</div>
        <div class="pillar-title">Mappatura completa</div>
        <p class="pillar-desc">Prima ancora di parlare di trattamenti, mappiamo ogni aspetto della tua situazione — quello che è già presente, quello che potrebbe evolvere, quello che è ancora sotto soglia.</p>
        <span class="pillar-tag">Niente sorprese</span>
      </div>

      <div class="pillar reveal">
        <div class="pillar-num">03</div>
        <div class="pillar-title">Non sei mai solo</div>
        <p class="pillar-desc">Se segui le nostre indicazioni e fai la giusta prevenzione, i problemi si riducono drasticamente. Ma se dovesse succedere qualcosa comunque — ci rimettiamo anche noi. Non sei solo tu a pagare le conseguenze.</p>
        <span class="pillar-tag">Trasparenza totale</span>
      </div>

      <div class="pillar reveal">
        <div class="pillar-num">04</div>
        <div class="pillar-title">Un percorso, non una lista</div>
        <p class="pillar-desc">Ogni piano è costruito sulla tua storia, i tuoi obiettivi, il tuo ritmo. Non esiste un protocollo uguale per tutti — esiste il tuo.</p>
        <span class="pillar-tag">Personalizzato</span>
      </div>

    </div>
  </div>
</div>

<!-- MANIFESTO -->
<div class="manifesto reveal">
  <p class="section-label">Il nostro approccio</p>
  <div class="manifesto-body">
    <div>
      <h2 class="section-title">La tua salute orale non è<br>un elenco di <em>problemi da mappare</em></h2>
      <p class="manifesto-text">
        La maggior parte delle persone si fa seguire <strong>solo quando è troppo tardi</strong>. E ogni volta si trova di fronte a una lista di terapie da eseguire, con costi che non erano stati preventivati.
      </p>
      <p class="manifesto-text">
        Noi lavoriamo al contrario. Prima di qualsiasi intervento, <strong>costruiamo un quadro completo della tua situazione</strong> — digitale, leggibile, sempre tuo. Poi ti spieghiamo cosa c'è, cosa verrà, e cosa fare per evitare che arrivi.
      </p>
      <p class="manifesto-text">
        Si chiama <strong>Piano Protezione</strong>. È il modo in cui seguiamo i nostri pazienti nel lungo termine.
      </p>
    </div>
    <div>
      <div class="manifesto-quote">
        <p>«Il professionista migliore è quello che nel tempo ti cura meno.»</p>
        <span>— La nostra filosofia</span>
      </div>
    </div>
  </div>
</div>

<!-- MYSTERY -->
<div class="mystery">
  <div class="mystery-inner">
    <h2>C'è qualcosa che non ti diciamo ancora.</h2>
    <p>Il Piano Protezione include elementi che spieghiamo solo di persona, perché alcune cose funzionano meglio quando le vedi con i tuoi occhi.</p>
    <a href="#contatto" class="mystery-cta">Voglio sapere di più</a>
  </div>
</div>

<!-- PROMISE -->
<div class="promise reveal">
  <p class="section-label">La nostra promessa</p>
  <div class="promise-grid">
    <div>
      <h2 class="section-title">Se sbagliamo noi,<br><em>non paghi tu</em>.</h2>
      <ul class="promise-list">
        <li>
          <div class="promise-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div class="promise-text">
            <strong>Responsabilità diretta</strong>
            <p>Se segui le nostre indicazioni e fai la giusta prevenzione, i problemi si riducono drasticamente. Ma se dovesse succedere qualcosa lo stesso — ci rimettiamo anche noi, economicamente. Non sei solo tu a pagare.</p>
          </div>
        </li>
        <li>
          <div class="promise-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div class="promise-text">
            <strong>Nessun preventivo a sorpresa</strong>
            <p>Prima di iniziare qualsiasi percorso, sai già cosa farai, quanto costerà, e perché. Sempre.</p>
          </div>
        </li>
        <li>
          <div class="promise-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
          <div class="promise-text">
            <strong>Aggiornamento continuo</strong>
            <p>La tua cartella digitale viene aggiornata a ogni appuntamento. Il tuo quadro clinico non sparisce mai tra una visita e l'altra.</p>
          </div>
        </li>
      </ul>
    </div>
    <div class="promise-aside reveal">
      <div class="big">&#8734;</div>
      <p>Il Piano Protezione non ha una scadenza. È un rapporto continuativo — non una prestazione singola.</p>
    </div>
  </div>
</div>

<!-- CTA -->
<div class="hook reveal" id="contatto">
  <p class="section-label">Inizia</p>
  <h2 class="section-title">Vuoi capire se fa per te?</h2>
  <p class="hook-sub">
    Non ti chiediamo di prenotare subito. Ti chiediamo solo di fare una prima chiacchierata — senza impegno, senza fretta.
  </p>
  <div class="cta-buttons">
    <a href="https://wa.me/393924076794?text=Ciao,%20vorrei%20sapere%20di%20pi%C3%B9%20sul%20Piano%20Protezione" class="hook-btn filled" target="_blank">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.121 1.532 5.849L.057 23.571a.75.75 0 0 0 .92.92l5.733-1.476A11.943 11.943 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.686-.523-5.204-1.431l-.364-.216-3.762.968.993-3.648-.235-.378A9.956 9.956 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      Scrivici su WhatsApp
    </a>
    <a href="tel:+393924076794" class="hook-btn">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 11.9 19.79 19.79 0 0 1 1.08 3.27 2 2 0 0 1 3.05 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16l.92.92z"/></svg>
      Chiama ora
    </a>
  </div>
  <p class="tel-display">oppure chiama direttamente: <a href="tel:+393924076794">392 407 6794</a></p>
</div>

<footer>
  <div class="footer-logo">Healthy Smile by N</div>
  <p>Via Madama Cristina 2, Torino</p>
  <p>&copy; 2025 Healthy Smile by N. Tutti i diritti riservati.</p>
</footer>

<script>
  const els = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) {
        setTimeout(() => e.target.classList.add('visible'), i * 80);
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  els.forEach(el => io.observe(el));

  // Tracciamento conversioni Google Ads su click CTA
  document.querySelectorAll('a[href^="https://wa.me"], a[href^="tel:"]').forEach(function(el) {
    el.addEventListener('click', function() {
      gtag('event', 'conversion', { 'send_to': 'AW-947982327' });
    });
  });
</script>

</body>
</html>
